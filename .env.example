# 运行时环境变量模板 — 复制为 .env 后填写
# 用法: cp .env.example .env
# npm run deploy 会将其注入远程 Docker 容器（--env-file）
#
# 本地开发可复制到 landing/.env.local:
#   cp .env.example landing/.env.local
#
# 注意: NEXT_PUBLIC_* 会在 next build 时写入前端产物。
# 若修改这些变量，需要重新 docker build 后部署，仅改 .env 重启容器不够。

# 站点公网 URL（sitemap、metadata、Skill 页链接）
PUBLIC_SITE_URL=https://clovapi.com
NEXT_PUBLIC_SITE_URL=https://clovapi.com

# GitHub 链接（可选，默认 https://github.com/joohw/clovapi）
NEXT_PUBLIC_GITHUB_URL=https://github.com/joohw/clovapi

# 桌面客户端下载地址（可选，默认 downloads.clovapi.com/desktop/latest）
NEXT_PUBLIC_DESKTOP_DOWNLOAD_MAC_URL=
NEXT_PUBLIC_DESKTOP_DOWNLOAD_WINDOWS_URL=

# Cloudflare R2 发布（GitHub Actions secrets；本地 scripts/r2-publish.sh 也可用）
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ARTIFACT_PREFIX=clovapi
# R2_PUBLIC_BASE_URL=https://downloads.clovapi.com
