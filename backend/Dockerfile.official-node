FROM node:22-alpine AS web-builder
WORKDIR /src
COPY package.json ./
COPY web/package*.json ./web/
RUN npm ci --prefix web
COPY web ./web
RUN npm run build:web

FROM golang:1.25-alpine AS core-builder
WORKDIR /src/core
COPY core/go.mod core/go.sum ./
RUN go mod download
COPY core ./
COPY --from=web-builder /src/core/internal/webui/dist ./internal/webui/dist
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/clovapi ./cmd

FROM node:22-alpine
RUN addgroup -S clovapi && adduser -S -G clovapi clovapi && mkdir -p /var/lib/clovapi && chown clovapi:clovapi /var/lib/clovapi
COPY --from=core-builder /out/clovapi /app/clovapi
COPY scripts/official-node-runtime.mjs /app/scripts/official-node-runtime.mjs
ENV XDG_CONFIG_HOME=/var/lib/clovapi
VOLUME ["/var/lib/clovapi"]
USER clovapi
CMD ["node", "/app/scripts/official-node-runtime.mjs"]
