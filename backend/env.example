CLOVAPI_BACKEND_PORT=3100
# Optional during migration: unknown paths are forwarded to this Next.js origin.
CLOVAPI_FRONTEND_URL=
CLOVAPI_PUBLIC_ORIGIN=https://api.clovapi.com
CLOVAPI_ALLOWED_ORIGINS=https://clovapi.com,https://www.clovapi.com,http://localhost:3000,http://127.0.0.1:3000
CLOVAPI_SECURE_COOKIES=true
AUTH_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=
RESEND_FROM=
# Only needed while frontend proxying or the legacy /internal/events endpoint is in use.
CLOVAPI_RELAY_SECRET=
CLOVAPI_RELAY_TRUST_PROXY=true
