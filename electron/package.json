{
  "name": "clovapi-desktop-minimal",
  "private": true,
  "version": "0.1.0",
  "description": "Minimal desktop CLI runner for ClovAPI",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev:ui": "vite --config ui/vite.config.mjs",
    "dev": "concurrently -k \"npm run dev:ui\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "build:ui": "vite build --config ui/vite.config.mjs",
    "test": "node --test proxy-manager.test.js proxy-ingress-url.test.js",
    "start": "npm run build:ui && electron ."
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.7",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^42.0.1",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.33.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "bits-ui": "^2.18.1",
    "clovapi": "file:..",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  }
}
