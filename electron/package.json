{
  "name": "clovapi-desktop-minimal",
  "private": true,
  "version": "0.1.0",
  "description": "Minimal desktop CLI runner for ClovAPI",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev:ui": "vite --config ui/vite.config.mjs",
    "prepare:cli:dev": "node scripts/prepare-dev-cli.mjs",
    "dev": "npm run prepare:cli:dev && concurrently -k \"npm run dev:ui\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "build:ui": "vite build --config ui/vite.config.mjs",
    "build:icons": "zsh scripts/build-icons.sh",
    "prepare:cli:darwin": "node scripts/prepare-darwin-cli.mjs",
    "prepare:cli:win": "node scripts/prepare-win-cli.mjs",
    "build:mac": "npm run build:ui && npm run build:icons && npm run prepare:cli:darwin && electron-builder --mac dmg",
    "build:win": "npm run build:ui && npm run prepare:cli:win && electron-builder --win nsis",
    "test": "node --test proxy-manager.test.js",
    "start": "npm run build:ui && electron ."
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.7",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.33.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "bits-ui": "^2.18.1",
    "clovapi": "file:..",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  },
  "build": {
    "appId": "com.clovapi.switcher",
    "productName": "ClovAPI Switcher",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!ui/**",
      "!dist/**",
      "!bin/**",
      "!scripts/**",
      "!**/*.test.js",
      "!node_modules/clovapi/**"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "bin/clovapi",
          "to": "bin/clovapi"
        }
      ]
    },
    "dmg": {
      "artifactName": "clovapi-desktop-darwin-universal.${ext}"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "extraResources": [
        {
          "from": "bin/clovapi.exe",
          "to": "bin/clovapi.exe"
        }
      ],
      "artifactName": "clovapi-desktop-windows-${arch}.${ext}"
    }
  }
}
