{
  "name": "clovapi-switcher",
  "private": true,
  "version": "0.2.13",
  "description": "ClovAPI Switcher desktop app",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev:ui": "vite --config ui/vite.config.mjs",
    "prepare:cli:dev": "node scripts/prepare-dev-cli.mjs",
    "dev": "node scripts/dev.mjs",
    "build:ui": "vite build --config ui/vite.config.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:mac": "npm run build:ui && npm run build:icons && electron-builder --mac dmg",
    "build:win": "npm run build:ui && electron-builder --win nsis",
    "test": "node --test clovapi-proxy.test.js clovapi-exec.test.js cli-path-register.test.js tray-menu.test.js tray-model-switch.test.js desktop-update.test.js call-logs-store.test.js",
    "start": "npm run build:ui && electron ."
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.7",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.33.0",
    "svelte-sonner": "^1.1.1",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.2",
    "tailwind-variants": "^3.2.2",
    "to-ico": "^1.1.5",
    "tailwindcss": "^4.1.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "bits-ui": "^2.18.1",
    "clovapi": "file:..",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  },
  "build": {
    "appId": "com.clovapi.switcher",
    "productName": "ClovAPI Switcher",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!ui/**",
      "!dist/**",
      "!bin/**",
      "!scripts/**",
      "!**/*.test.js",
      "!node_modules/clovapi/**"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "clovapi-desktop-darwin-universal.${ext}"
    },
    "win": {
      "icon": "assets/icon.ico",
      "executableName": "ClovAPI Switcher",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "clovapi-desktop-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "allowElevation": true,
      "runAfterFinish": true,
      "shortcutName": "ClovAPI Switcher",
      "uninstallDisplayName": "ClovAPI Switcher"
    }
  }
}
