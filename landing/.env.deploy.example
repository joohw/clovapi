# 旧 VPS 回滚路径的部署凭据模板，不参与 Cloudflare Workers 发布。
# Cloudflare 生产环境由连接 main 分支的 Workers Builds 自动发布；参见
# landing/README.md 和 platform/README.md。仅需要回滚旧容器时才复制本文件。
#
# 部署凭据模板 — 复制为 .env.deploy 后填写（与本目录 .env 同级）
# 用法: cp .env.deploy.example .env.deploy
# 供仓库根目录 npm run deploy:legacy-vps 读取（本地执行，不会上传到容器）
#
# Docker 镜像仓库（留空则 docker login / push 使用 Docker Hub 默认域名）
DOCKER_REGISTRY=

# 镜像仓库登录
DOCKER_USERNAME=
DOCKER_PASSWORD=

# 镜像名称与标签（可选，默认 clovapi:latest）
DOCKER_IMAGE_NAME=clovapi
DOCKER_IMAGE_TAG=latest

# 远程服务器 SSH
SSH_HOST=
SSH_PORT=22
SSH_USERNAME=
SSH_PASSWORD=

# 远程容器（可选）
REMOTE_CONTAINER_NAME=clovapi
REMOTE_FRONTEND_PORT=27483

# 官方贡献节点（配置官方连接 Key 后随站点一起部署，不映射公网端口）
# Key 来自官方账户控制台的 `clovapi share start --key ...` 命令，不是消费者 API Key。
# DEPLOY_OFFICIAL_NODE_KEY=clv_connect_...
# DEPLOY_OFFICIAL_NODE_DAILY_LIMIT=100000
# DEPLOY_OFFICIAL_NODE_HOST_PORT=28473
# DEPLOY_OFFICIAL_NODE_CONTAINER_NAME=clovapi-official-node
# DEPLOY_OFFICIAL_NODE_DATA_VOLUME=clovapi-official-node-data

# 可选：跳过本地 build/push，仅 SSH 重启容器
# DEPLOY_SKIP_IMAGE_UPDATE=false

# 可选：docker build 时拉取最新基础镜像（网络不稳时可保持 false）
# DEPLOY_DOCKER_PULL_BASE=false
