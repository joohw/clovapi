# 运行时环境变量模板 — 复制为 .env 后填写
# 用法: cp .env.example .env
# 仓库根目录 npm run deploy 会将其注入远程 Docker 容器（--env-file）
#
# 本地开发可复制为 .env.local:
#   cp .env.example .env.local
#
# 站点 URL、GitHub 链接、桌面下载地址已硬编码在 landing/src/lib/site.ts 与 downloads.ts。

# Cloudflare R2 发布（GitHub Actions secrets；本地 scripts/r2-publish.sh 也可用）
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ARTIFACT_PREFIX=clovapi
# R2_PUBLIC_BASE_URL=https://downloads.clovapi.com
