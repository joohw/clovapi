# 公开的构建时环境变量模板。仅本地开发需要时复制为 .env.local：
#   cp .env.example .env.local
#
# Workers Static Assets 没有 Next.js 运行时；修改此变量后必须重新 build/deploy。
# 站点 URL、GitHub 链接、桌面下载地址位于 landing/src/lib/site.ts 与 downloads.ts。

# 浏览器直接请求独立 Platform Worker；本地开发可指向本地 platform 服务。
NEXT_PUBLIC_CLOVAPI_API_URL=http://127.0.0.1:8787

# 此目录只允许 NEXT_PUBLIC_* 公开变量。账户、邮件、数据库和 Relay 等变量
# 属于 Platform Worker，不应注入静态 Web App。

# 以下 R2 凭据只用于 CLI 二进制制品发布，与 Platform/Landing Wrangler 发布
# 无关（release-switcher workflow secrets；本地 scripts/r2-publish.sh 也可用）。
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ARTIFACT_PREFIX=clovapi
# R2_PUBLIC_BASE_URL=https://downloads.clovapi.com
