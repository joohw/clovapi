FROM node:22-alpine AS builder
WORKDIR /app/landing
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_CLOVAPI_API_URL=https://api.clovapi.com
ENV NEXT_PUBLIC_CLOVAPI_API_URL=$NEXT_PUBLIC_CLOVAPI_API_URL

COPY landing/package*.json ./
RUN npm ci
COPY landing ./
RUN npm run build

FROM node:22-alpine
WORKDIR /app/landing
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY landing/package*.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY --from=builder /app/landing/.next ./.next
COPY --from=builder /app/landing/public ./public
COPY --from=builder /app/landing/content ./content
EXPOSE 3000
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3000"]
