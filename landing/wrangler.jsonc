{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clovapi-landing",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "clovapi.com/*",
      "zone_name": "clovapi.com"
    },
    {
      "pattern": "www.clovapi.com/*",
      "zone_name": "clovapi.com"
    }
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
