{
  "name": "clovapi",
  "private": true,
  "version": "0.0.0",
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --prefix web run dev",
    "dev:desktop": "npm --prefix electron run dev",
    "desktop:install": "npm --prefix electron install",
    "deploy": "node scripts/deploy.mjs",
    "switcher:test": "go -C switcher test ./...",
    "switcher:build": "go -C switcher build -o clovapi ./cmd/clovapi",
    "switcher:build:versioned": "go -C switcher build -ldflags \"-X main.version=dev-local -X main.commit=local -X main.date=local\" -o clovapi ./cmd/clovapi",
    "switcher:npm:pack": "cd switcher/npm && npm pack --dry-run"
  }
}
